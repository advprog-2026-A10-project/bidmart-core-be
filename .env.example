# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8081

# Database Configuration
APP_DATABASE_URL=postgres://[Placeholder]:postgres@localhost:15001/bidmart_core

# URL for authentication service
APP_AUTH_BASE_URL=http://localhost:8080

# Optional: run SQLx migrations automatically on API startup.
# Keep false in production and run explicit migrate job instead.
APP_AUTO_MIGRATE_ON_STARTUP=false

# Bidding lifecycle worker (optional)
APP_BIDDING_FINALIZER_INTERVAL_SECS=5
APP_BIDDING_FINALIZER_BATCH_SIZE=25
