# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8081

# Database Configuration
APP_DATABASE_URL=postgres://[Placeholder]:postgres@localhost:15001/bidmart_core

# URL for authentication service
APP_AUTH_BASE_URL=http://localhost:8080

# Run SQLx migrations automatically on API startup.
# Defaults to `true` so `cargo run` against a fresh database brings the
# schema up in one step. Set to `false` in production and run the
# dedicated `cargo run --bin migrate` job in a separate, controlled step.
APP_AUTO_MIGRATE_ON_STARTUP=true

# Bidding lifecycle worker (optional)
APP_BIDDING_FINALIZER_INTERVAL_SECS=5
APP_BIDDING_FINALIZER_BATCH_SIZE=25

# RabbitMQ Configuration
APP_AMQP_URL=amqp://guest:guest@localhost:5672/%2f
